# Copy to .env and replace both placeholders with long random values.
# Use URL-safe characters for POSTGRES_PASSWORD (e.g. a random hex string).
POSTGRES_PASSWORD=replace_with_a_random_database_password
PRODUCT_ANALYTICS_ADMIN_TOKEN=replace_with_a_random_admin_token
POSTGRES_PORT=55433
PRODUCT_ANALYTICS_PORT=8080
# Secure cookies are on by default. Use false only for direct loopback development.
# When false, administrator login and authenticated API access are rejected for non-loopback hosts.
PRODUCT_ANALYTICS_SECURE_COOKIES=true
PRODUCT_ANALYTICS_MAX_EVENTS_PER_PROJECT=1000000
PRODUCT_ANALYTICS_MAX_QUERY_EVENTS=100000
# For running Go on the host; match the password and port above.
DATABASE_URL=postgres://product_analytics:replace_with_a_random_database_password@127.0.0.1:55433/product_analytics?sslmode=disable
