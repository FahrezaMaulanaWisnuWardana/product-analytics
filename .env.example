# Copy to .env and replace both placeholders with long random values.
# Use URL-safe characters for POSTGRES_PASSWORD (e.g. a random hex string).
POSTGRES_PASSWORD=replace_with_a_random_database_password
PULSE_ADMIN_TOKEN=replace_with_a_random_admin_token
POSTGRES_PORT=55433
PULSE_PORT=8080
# Secure cookies are on by default. Use false only for direct loopback development.
# When false, administrator login and authenticated API access require a loopback peer and host.
PULSE_SECURE_COOKIES=true
PULSE_MAX_EVENTS_PER_PROJECT=1000000
PULSE_MAX_QUERY_EVENTS=100000
PULSE_AUDIT_RETENTION_DAYS=365
PULSE_REVOKED_TOKEN_RETENTION_DAYS=90
# Optional: local MaxMind-compatible GeoIP country database. No IP is stored by this lookup.
# PULSE_GEOIP_DATABASE=/path/to/GeoLite2-Country.mmdb
# Trust forwarded IPs only from these proxy CIDR ranges (comma-separated).
# PULSE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# For running Go on the host; match the password and port above.
DATABASE_URL=postgres://product_analytics:replace_with_a_random_database_password@127.0.0.1:55433/product_analytics?sslmode=disable
